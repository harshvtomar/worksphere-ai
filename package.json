{
  "name": "worksphere-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,magenta \"npm run dev -w @worksphere/web\" \"npm run dev -w @worksphere/api\"",
    "build": "npm run build -w @worksphere/api && npm run build -w @worksphere/web",
    "typecheck": "npm run typecheck -w @worksphere/api && npm run typecheck -w @worksphere/web",
    "test": "node --test tests/*.test.mjs",
    "db:generate": "npm run generate -w @worksphere/database",
    "db:validate": "npm run validate -w @worksphere/database",
    "db:migrate": "npm run migrate -w @worksphere/database",
    "db:studio": "npm run studio -w @worksphere/database",
    "smoke": "node tests/runtime-smoke.mjs",
    "verify:stage1": "node scripts/verify-stage1.mjs",
    "test:config": "node --test tests/runtime-config.mjs",
    "db:deploy": "npm run deploy -w @worksphere/database",
    "test:database": "node --test tests/database-checks.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "concurrently": "^9.2.1",
    "pg": "^8.23.1",
    "typescript": "~5.9.3"
  }
}

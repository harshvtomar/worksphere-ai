PORT=4000
CORS_ORIGINS=http://localhost:3000
# Use the same local PostgreSQL database as packages/database/.env.
DATABASE_URL=postgresql://worksphere:worksphere_dev_only@127.0.0.1:5432/worksphere?schema=public
WEB_ORIGIN=http://localhost:3000
# Generate locally: openssl rand -hex 32. Never commit the actual value.
SESSION_SECRET=
# Register WEB_ORIGIN/v1/auth/callback as the exact OIDC redirect URI.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Set to 1 only behind your controlled single-hop TLS reverse proxy.
TRUST_PROXY=0
